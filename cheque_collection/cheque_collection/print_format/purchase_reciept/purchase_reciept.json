 "html": "<style> \n    @media print {\n        body { margin: 0; padding: 15px; }\n    }\n    \n    .goods-received-voucher {\n        font-family: Arial, sans-serif;\n        max-width: 210mm;\n        margin: 0 auto;\n        padding: 15px;\n        font-size: 8pt;\n    }\n    \n    .company-header {\n        margin-bottom: 15px;\n    }\n    \n    .company-name {\n        font-size: 12pt;\n        font-weight: bold;\n        margin-bottom: 3px;\n    }\n    \n    .company-details {\n        font-size: 7pt;\n        line-height: 1.3;\n    }\n    \n    .voucher-title {\n        text-align: center;\n        font-size: 11pt;\n        font-weight: bold;\n        margin: 15px 0;\n    }\n    \n    .header-section {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 15px;\n    }\n    \n    .supplier-box {\n        flex: 1;\n        border: 1px solid #000;\n        padding: 8px;\n        margin-right: 10px;\n    }\n    \n    .doc-info-box {\n        flex: 1;\n        border: 1px solid #000;\n        padding: 8px;\n    }\n    \n    .box-row {\n        margin-bottom: 5px;\n        font-size: 8pt;\n    }\n    \n    .field-label {\n        font-weight: bold;\n        display: inline-block;\n        min-width: 80px;\n    }\n    \n    .store-section {\n        border: 1px solid #000;\n        padding: 8px;\n        margin-bottom: 10px;\n        font-weight: bold;\n        text-align: center;\n        background-color: #f5f5f5;\n    }\n    \n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 15px;\n        font-size: 7pt;\n    }\n    \n    .items-table th {\n        background-color: #f5f5f5;\n        border: 1px solid #000;\n        padding: 4px;\n        text-align: left;\n        font-weight: bold;\n    }\n    \n    .items-table td {\n        border: 1px solid #000;\n        padding: 4px;\n    }\n    \n    .text-right {\n        text-align: right;\n    }\n    \n    .text-center {\n        text-align: center;\n    }\n    \n    .total-row {\n        font-weight: bold;\n        background-color: #f9f9f9;\n    }\n    \n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 50px;\n        padding-top: 20px;\n    }\n    \n    .signature-box {\n        text-align: center;\n        font-weight: bold;\n    }\n    \n    .signature-line {\n        border-top: 1px solid #000;\n        margin-top: 40px;\n        padding-top: 5px;\n        min-width: 120px;\n    }\n</style>\n\n<div class=\"goods-received-voucher\">\n    <!-- Company Header -->\n    <div class=\"company-header\">\n        <div class=\"company-name\">{{ doc.company }}</div>\n        <div class=\"company-details\">\n            {% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n            Ware House No: 109, Mina Zayed<br>\n            P.O.Box: 34368 Abu Dhabi<br>\n            Tel: +971-2-4919267\n        </div>\n    </div>\n    \n    <!-- Voucher Title -->\n    <div class=\"voucher-title\">GOODS RECEIVED VOUCHER</div>\n    \n    <!-- Header Section -->\n    <div class=\"header-section\">\n        <!-- Supplier Box -->\n        <div class=\"supplier-box\">\n            <div class=\"box-row\">\n                <span class=\"field-label\">M/S</span><br>\n                <strong>{{ doc.supplier_name or doc.supplier }}</strong>\n            </div>\n            <div class=\"box-row\" style=\"margin-top: 10px;\">\n                <span class=\"field-label\">TRN</span><br>\n                {{ doc.tax_id or \"\" }}\n            </div>\n        </div>\n        \n        <!-- Document Info Box -->\n        <div class=\"doc-info-box\">\n            <div class=\"box-row\">\n                <span class=\"field-label\">GRN No:</span> {{ doc.name }}\n            </div>\n            <div class=\"box-row\">\n                <span class=\"field-label\">Date:</span> {{ doc.get_formatted(\"posting_date\") }}\n            </div>\n            <div class=\"box-row\">\n                <span class=\"field-label\">Delivery No:</span> {{ doc.lr_no or \"\" }}\n            </div>\n        </div>\n    </div>\n    \n    <!-- Store Section -->\n    <div class=\"store-section\">\n        {{ doc.set_warehouse or \"Kizad Store\" }}\n    </div>\n    \n    <!-- Items Table -->\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%;\">S. L.</th>\n                <th style=\"width: 25%;\">Item</th>\n                <th style=\"width: 10%;\">Length</th>\n                <th style=\"width: 8%;\">Qty</th>\n                <th style=\"width: 8%;\">Unit</th>\n                <th style=\"width: 10%;\">Batch #</th>\n                <th style=\"width: 12%;\">Total</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set total_length = 0 %}\n            {% set total_qty = 0 %}\n            {% set total_amount = 0 %}\n            \n            {% for item in doc.items %}\n            {% set item_length = item.custom_length or 0 %}\n            {% set total_length = total_length + item_length %}\n            {% set total_qty = total_qty + (item.qty or 0) %}\n            {% set total_amount = total_amount + (item.amount or 0) %}\n            <tr>\n                <td class=\"text-center\">{{ loop.index }}</td>\n                <td>{{ item.item_name or item.item_code }}</td>\n                <td class=\"text-right\">{{ \"{:.2f}\".format(item_length) }}</td>\n                <td class=\"text-right\">{{ \"{:.2f}\".format(item.qty or 0) }}</td>\n                <td class=\"text-center\">{{ item.uom or \"\" }}</td>\n                <td class=\"text-center\">{{ item.batch_no or \"\" }}</td>\n                <td class=\"text-right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Empty rows for spacing -->\n            {% for i in range(20 - (doc.items|length)) %}\n            <tr>\n                <td>&nbsp;</td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Total Row -->\n            <tr class=\"total-row\">\n                <td colspan=\"2\" class=\"text-right\"><strong>Total</strong></td>\n                <td class=\"text-right\">{{ \"{:.2f}\".format(total_length) }}</td>\n                <td class=\"text-right\">{{ \"{:.2f}\".format(total_qty) }}</td>\n                <td></td>\n                <td></td>\n                <td class=\"text-right\">{{ \"{:,.2f}\".format(total_amount) }}</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Signature Section -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Received by</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Checked by</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Entered</div>\n        </div>\n    </div>\n</div>",
