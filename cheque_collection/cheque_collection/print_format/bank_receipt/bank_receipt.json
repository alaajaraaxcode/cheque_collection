 "html": "<style> \n    @media print {\n        body { margin: 0; padding: 20px; }\n    }\n    \n    .receipt-voucher {\n        font-family: Arial, sans-serif;\n        max-width: 210mm;\n        margin: 0 auto;\n        padding: 20px;\n        font-size: 10pt;\n    }\n    \n    .voucher-header {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n    \n    .voucher-title {\n        font-size: 14pt;\n        font-weight: bold;\n        letter-spacing: 2px;\n        text-decoration: underline;\n        margin-bottom: 10px;\n    }\n    \n    .company-name {\n        font-size: 11pt;\n        margin-bottom: 5px;\n    }\n    \n    .header-info {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 15px;\n        font-size: 10pt;\n    }\n    \n    .header-left {\n        flex: 1;\n    }\n    \n    .header-right {\n        text-align: right;\n    }\n    \n    .field-row {\n        margin-bottom: 8px;\n    }\n    \n    .field-label {\n        display: inline-block;\n        font-weight: bold;\n        min-width: 80px;\n    }\n    \n    .cheque-ref-row {\n        margin: 15px 0;\n        padding: 8px 0;\n        border-top: 1px solid #ccc;\n        border-bottom: 1px solid #ccc;\n    }\n    \n    .details-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 20px 0;\n        font-size: 10pt;\n    }\n    \n    .details-table th {\n        background-color: #f5f5f5;\n        border: 1px solid #000;\n        padding: 6px;\n        text-align: left;\n        font-weight: bold;\n        font-size: 9pt;\n    }\n    \n    .details-table td {\n        border: 1px solid #000;\n        padding: 6px;\n        font-size: 9pt;\n    }\n    \n    .amount-right {\n        text-align: right;\n    }\n    \n    .total-row {\n        border-top: 2px solid #000;\n        font-weight: bold;\n    }\n    \n    .amount-words {\n        margin: 15px 0;\n        padding: 8px 0;\n        text-transform: uppercase;\n        font-weight: bold;\n        font-size: 9pt;\n    }\n    \n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 60px;\n        padding-top: 20px;\n    }\n    \n    .signature-box {\n        flex: 1;\n        text-align: center;\n        font-weight: bold;\n    }\n    \n    .signature-line {\n        border-top: 1px solid #000;\n        margin-top: 50px;\n        padding-top: 5px;\n    }\n    \n    .footer-info {\n        margin-top: 40px;\n        font-size: 9pt;\n    }\n    \n    .footer-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 5px;\n    }\n</style>\n\n<div class=\"receipt-voucher\">\n    <!-- Header -->\n    <div class=\"voucher-header\">\n        <div class=\"voucher-title\">RECEIPT VOUCHER</div>\n        <div class=\"company-name\">{{ frappe.defaults.get_user_default(\"Company\") or doc.company }}</div>\n    </div>\n    \n    <!-- Header Info -->\n    <div class=\"header-info\">\n        <div class=\"header-left\">\n            <div class=\"field-row\">\n                <strong>No.</strong> {{ doc.name }}\n            </div>\n            <div class=\"field-row\">\n                <strong>Account :-</strong> {{ doc.paid_to or \"\" }}\n            </div>\n        </div>\n        <div class=\"header-right\">\n            <div class=\"field-row\">\n                <strong>Date:</strong> {{ doc.get_formatted(\"posting_date\") }}\n            </div>\n            <div class=\"field-row\">\n                <strong>Ref:</strong>\n            </div>\n        </div>\n    </div>\n    \n    <!-- Cheque Reference -->\n    <div class=\"cheque-ref-row\">\n        <strong>Cheque Ref:</strong> {{ doc.reference_no or \"\" }}\n        {% if doc.reference_date %}\n            / {{ doc.get_formatted(\"reference_date\") }}\n        {% endif %}\n    </div>\n    \n    <!-- Details Table -->\n    <table class=\"details-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 40%;\">Name</th>\n                <th style=\"width: 30%;\">Against Ref.</th>\n                <th style=\"width: 15%;\">RV No.</th>\n                <th style=\"width: 15%;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% if doc.references %}\n                {% for row in doc.references %}\n                <tr>\n                    <td>{{ doc.party_name or doc.party }}</td>\n                    <td>{{ row.reference_name }}</td>\n                    <td>{{ doc.name }}</td>\n                    <td class=\"amount-right\">{{ row.get_formatted(\"allocated_amount\") }}</td>\n                </tr>\n                {% endfor %}\n            {% else %}\n                <tr>\n                    <td>{{ doc.party_name or doc.party }}</td>\n                    <td></td>\n                    <td>{{ doc.name }}</td>\n                    <td class=\"amount-right\">{{ doc.get_formatted(\"received_amount\") }}</td>\n                </tr>\n            {% endif %}\n            \n            <!-- Empty rows for spacing -->\n            {% for i in range(8) %}\n            <tr>\n                <td>&nbsp;</td>\n                <td></td>\n                <td></td>\n                <td></td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Total Row -->\n            <tr class=\"total-row\">\n                <td colspan=\"3\"><strong>Total</strong></td>\n                <td class=\"amount-right\">\n                    {{ doc.get_formatted(\"base_received_amount\") or doc.get_formatted(\"received_amount\") }}\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Amount in Words -->\n    <div class=\"amount-words\">\n        {{ frappe.utils.money_in_words(doc.base_received_amount or doc.received_amount, doc.company_currency) }}\n    </div>\n    \n    <!-- Signature Section -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Receiver's Sign</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Accountant</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Manager</div>\n        </div>\n    </div>\n    \n    <!-- Footer Info -->\n    <div class=\"footer-info\">\n        <div class=\"footer-row\">\n            <div><strong>Entered by:</strong></div>\n            <div>{{ doc.get_formatted(\"modified\") }}</div>\n        </div>\n        <div class=\"footer-row\">\n            <div>{{ doc.modified_by }}</div>\n            <div>{{ doc.get_formatted(\"modified\", \"HH:mm:ss\") }}</div>\n        </div>\n    </div>\n</div>",
