 "html": "<style> \n    @media print {\n        body { margin: 0; padding: 15px; }\n    }\n    \n    .petty-cash-voucher {\n        font-family: Arial, sans-serif;\n        max-width: 210mm;\n        margin: 0 auto;\n        padding: 20px;\n        font-size: 9pt;\n        border: 2px solid #000;\n    }\n    \n    .company-header {\n        text-align: center;\n        margin-bottom: 10px;\n    }\n    \n    .company-name {\n        font-size: 12pt;\n        font-weight: bold;\n        margin-bottom: 3px;\n    }\n    \n    .company-address {\n        font-size: 8pt;\n        margin-bottom: 15px;\n    }\n    \n    .voucher-title {\n        text-align: center;\n        font-size: 11pt;\n        font-weight: bold;\n        text-decoration: underline;\n        margin-bottom: 20px;\n    }\n    \n    .header-info {\n        border: 1px solid #000;\n        padding: 10px;\n        margin-bottom: 15px;\n    }\n    \n    .header-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 8px;\n        font-size: 9pt;\n    }\n    \n    .header-row:last-child {\n        margin-bottom: 0;\n    }\n    \n    .field-label {\n        font-weight: bold;\n    }\n    \n    .narration-section {\n        border: 1px solid #000;\n        padding: 8px;\n        margin-bottom: 15px;\n        min-height: 30px;\n    }\n    \n    .narration-label {\n        font-weight: bold;\n        margin-bottom: 5px;\n    }\n    \n    .details-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 15px;\n        font-size: 8pt;\n    }\n    \n    .details-table th {\n        background-color: #f5f5f5;\n        border: 1px solid #000;\n        padding: 5px;\n        text-align: left;\n        font-weight: bold;\n    }\n    \n    .details-table td {\n        border: 1px solid #000;\n        padding: 5px;\n    }\n    \n    .text-right {\n        text-align: right;\n    }\n    \n    .text-center {\n        text-align: center;\n    }\n    \n    .total-row {\n        font-weight: bold;\n        background-color: #f9f9f9;\n    }\n    \n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 40px;\n        padding-top: 20px;\n        border-top: 1px solid #000;\n    }\n    \n    .signature-box {\n        flex: 1;\n        text-align: center;\n        font-weight: bold;\n    }\n    \n    .signature-line {\n        border-top: 1px solid #000;\n        margin-top: 50px;\n        padding-top: 5px;\n    }\n</style>\n\n<div class=\"petty-cash-voucher\">\n    <!-- Company Header -->\n    <div class=\"company-header\">\n        <div class=\"company-name\">{{ doc.company }}</div>\n        <div class=\"company-address\">\n            {% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n            PO Box 54363, Abu Dhabi, UAE\n        </div>\n    </div>\n    \n    <!-- Voucher Title -->\n    <div class=\"voucher-title\">PETTY CASH VOUCHER</div>\n    \n    <!-- Header Info Box -->\n    <div class=\"header-info\">\n        <div class=\"header-row\">\n            <div><span class=\"field-label\">Date :</span> {{ doc.get_formatted(\"posting_date\") }}</div>\n            <div style=\"text-align: center;\">{{ doc.party_name or doc.party or \"\" }}</div>\n            <div style=\"text-align: right;\"><span class=\"field-label\">No :</span> {{ doc.name }}</div>\n        </div>\n    </div>\n    \n    <!-- Narration Section -->\n    <div class=\"narration-section\">\n        <div class=\"narration-label\">Narration :</div>\n        <div>{{ doc.remarks or doc.user_remark or \"\" }}</div>\n    </div>\n    \n    <!-- Details Table -->\n    <table class=\"details-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 8%;\">S.No</th>\n                <th style=\"width: 15%;\">A/c Code</th>\n                <th style=\"width: 32%;\">Account</th>\n                <th style=\"width: 12%;\">Debit</th>\n                <th style=\"width: 12%;\">Credit</th>\n                <th style=\"width: 21%;\">Remarks</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set total_debit = 0 %}\n            {% set total_credit = 0 %}\n            \n            <!-- Payment Account Entry (Credit) -->\n            <tr>\n                <td class=\"text-center\">1</td>\n                <td>{{ doc.paid_from }}</td>\n                <td>{{ doc.paid_from }}</td>\n                <td class=\"text-right\"></td>\n                <td class=\"text-right\">{{ \"{:.2f}\".format(doc.paid_amount or 0) }}</td>\n                <td>{{ doc.mode_of_payment or \"\" }}</td>\n            </tr>\n            {% set total_credit = total_credit + (doc.paid_amount or 0) %}\n            \n            <!-- Reference Entries (Debit) -->\n            {% if doc.references %}\n                {% for row in doc.references %}\n                <tr>\n                    <td class=\"text-center\">{{ loop.index + 1 }}</td>\n                    <td>{{ row.reference_name }}</td>\n                    <td>{{ row.reference_doctype }}: {{ row.reference_name }}</td>\n                    <td class=\"text-right\">{{ \"{:.2f}\".format(row.allocated_amount or 0) }}</td>\n                    <td class=\"text-right\"></td>\n                    <td>{{ row.remarks or \"\" }}</td>\n                </tr>\n                {% set total_debit = total_debit + (row.allocated_amount or 0) %}\n                {% endfor %}\n            {% endif %}\n            \n            <!-- Deductions as separate entries -->\n            {% if doc.deductions %}\n                {% for deduction in doc.deductions %}\n                <tr>\n                    <td class=\"text-center\">{{ (doc.references|length if doc.references else 0) + loop.index + 1 }}</td>\n                    <td>{{ deduction.account }}</td>\n                    <td>{{ deduction.account }}</td>\n                    <td class=\"text-right\">{{ \"{:.2f}\".format(deduction.amount or 0) }}</td>\n                    <td class=\"text-right\"></td>\n                    <td>{{ deduction.cost_center or \"\" }}</td>\n                </tr>\n                {% set total_debit = total_debit + (deduction.amount or 0) %}\n                {% endfor %}\n            {% endif %}\n            \n            <!-- Empty rows for spacing -->\n            {% set existing_rows = (doc.references|length if doc.references else 0) + (doc.deductions|length if doc.deductions else 0) + 1 %}\n            {% for i in range(15 - existing_rows) %}\n            <tr>\n                <td>&nbsp;</td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Total Row -->\n            <tr class=\"total-row\">\n                <td colspan=\"3\" class=\"text-right\"><strong>Total</strong></td>\n                <td class=\"text-right\">{{ \"{:,.2f}\".format(total_debit) }}</td>\n                <td class=\"text-right\">{{ \"{:,.2f}\".format(total_credit) }}</td>\n                <td></td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Signature Section -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Prepared by</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Checked By</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Authorized By</div>\n        </div>\n    </div>\n</div>",
