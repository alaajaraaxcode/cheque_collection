 "html": "<style> \n    @media print {\n        body { margin: 0; padding: 20px; }\n    }\n    \n    .pdc-payment-voucher {\n        font-family: Arial, sans-serif;\n        max-width: 210mm;\n        margin: 0 auto;\n        padding: 20px;\n        font-size: 10pt;\n    }\n    \n    .voucher-title {\n        text-align: center;\n        font-size: 14pt;\n        font-weight: bold;\n        letter-spacing: 2px;\n        text-decoration: underline;\n        margin-bottom: 25px;\n    }\n    \n    .header-section {\n        margin-bottom: 20px;\n    }\n    \n    .header-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 10px;\n        font-size: 10pt;\n    }\n    \n    .header-left {\n        flex: 1;\n    }\n    \n    .header-center {\n        flex: 1;\n        text-align: center;\n        font-weight: bold;\n    }\n    \n    .header-right {\n        flex: 1;\n        text-align: right;\n    }\n    \n    .field-label {\n        font-weight: bold;\n        display: inline-block;\n        min-width: 90px;\n    }\n    \n    .cheque-row {\n        margin: 15px 0;\n        padding: 10px 0;\n    }\n    \n    .details-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 20px 0;\n        font-size: 9pt;\n    }\n    \n    .details-table th {\n        background-color: #f5f5f5;\n        border: 1px solid #000;\n        padding: 6px;\n        text-align: left;\n        font-weight: bold;\n    }\n    \n    .details-table td {\n        border: 1px solid #000;\n        padding: 6px;\n    }\n    \n    .amount-right {\n        text-align: right;\n    }\n    \n    .total-row {\n        border-top: 2px solid #000;\n        font-weight: bold;\n    }\n    \n    .amount-words {\n        margin: 15px 0;\n        padding: 8px 0;\n        text-transform: uppercase;\n        font-weight: bold;\n        font-size: 9pt;\n    }\n    \n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 80px;\n        padding-top: 20px;\n    }\n    \n    .signature-box {\n        flex: 1;\n        text-align: center;\n        font-weight: bold;\n    }\n    \n    .signature-line {\n        border-top: 1px solid #000;\n        margin-top: 60px;\n        padding-top: 5px;\n    }\n</style>\n\n<div class=\"pdc-payment-voucher\">\n    <!-- Title -->\n    <div class=\"voucher-title\">PDC PAYMENT VOUCHER</div>\n    \n    <!-- Header Section -->\n    <div class=\"header-section\">\n        <div class=\"header-row\">\n            <div class=\"header-left\">\n                <strong>No.</strong> {{ doc.name }}\n            </div>\n            <div class=\"header-center\">\n                {{ doc.party_name or doc.party }}\n            </div>\n            <div class=\"header-right\">\n                <strong>Due Date :</strong> {{ doc.get_formatted(\"reference_date\") if doc.reference_date else \"\" }}\n            </div>\n        </div>\n        \n        <div class=\"header-row\">\n            <div class=\"header-left\">\n                <strong>Cheque No:</strong> {{ doc.reference_no or \"\" }}\n            </div>\n            <div class=\"header-center\">\n                <!-- Empty center space -->\n            </div>\n            <div class=\"header-right\">\n                <strong>Ref:</strong>\n            </div>\n        </div>\n        \n        <div class=\"header-row\">\n            <div class=\"header-left\">\n                <!-- Empty left space -->\n            </div>\n            <div class=\"header-center\">\n                <!-- Empty center space -->\n            </div>\n            <div class=\"header-right\">\n                <strong>Date:</strong> {{ doc.get_formatted(\"posting_date\") }}\n            </div>\n        </div>\n    </div>\n    \n    <!-- Details Table -->\n    <table class=\"details-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 40%;\">Name</th>\n                <th style=\"width: 25%;\">Invoice No.</th>\n                <th style=\"width: 15%;\">RV No.</th>\n                <th style=\"width: 20%;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% if doc.references %}\n                {% for row in doc.references %}\n                <tr>\n                    <td>{{ doc.party_name or doc.party }}</td>\n                    <td>{{ row.reference_name }}</td>\n                    <td>{{ doc.name }}</td>\n                    <td class=\"amount-right\">{{ row.get_formatted(\"allocated_amount\") }}</td>\n                </tr>\n                {% endfor %}\n            {% else %}\n                <tr>\n                    <td>{{ doc.party_name or doc.party }}</td>\n                    <td></td>\n                    <td>{{ doc.name }}</td>\n                    <td class=\"amount-right\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n                </tr>\n            {% endif %}\n            \n            <!-- Empty rows for spacing -->\n            {% for i in range(10) %}\n            <tr>\n                <td>&nbsp;</td>\n                <td></td>\n                <td></td>\n                <td></td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Total Row -->\n            <tr class=\"total-row\">\n                <td colspan=\"3\"><strong>Total</strong></td>\n                <td class=\"amount-right\">\n                    {{ doc.get_formatted(\"paid_amount\") }}\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Amount in Words -->\n    <div class=\"amount-words\">\n        {{ frappe.utils.money_in_words(doc.paid_amount, doc.paid_from_account_currency or doc.company_currency) }}\n    </div>\n    \n    <!-- Signature Section -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Receiver's Sign</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Accountant</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Manager</div>\n        </div>\n    </div>\n</div>",
